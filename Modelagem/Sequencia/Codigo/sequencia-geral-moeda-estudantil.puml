@startuml

title **Diagrama de Sequência Geral - Sistema Moeda Estudantil**
header **Fluxo Principal do Negócio**
footer **\n© Karen Joilly, Josué Goulart, Luiz Fernando**

actor Professor
actor Aluno
actor Empresa

participant "Frontend\nReact" as WEB
participant API
participant "Auth Service" as AUTH
participant "Moedas Service" as MOEDAS
participant "Vantagens Service" as VANTAGENS
participant "Cupom Service" as CUPOM
queue "RabbitMQ\nCloudAMQP" as FILA
participant "Notificação Service" as NOTIF
database PostgreSQL as DB

== 1. Professor distribui moedas ==

Professor -> WEB : acessarDistribuição()
activate WEB

WEB -> API : POST /enviar-moedas
activate API

API -> AUTH : validarToken()
activate AUTH
AUTH --> API : tokenValido
deactivate AUTH

API -> MOEDAS : enviarMoedas()

activate MOEDAS

MOEDAS -> DB : validarSaldoProfessor()
activate DB
DB --> MOEDAS : saldoOk

MOEDAS -> DB : registrarTransacao()
DB --> MOEDAS : transacaoId

deactivate DB

MOEDAS --> API : distribuicaoRealizada()
deactivate MOEDAS

API -> FILA : publicarEventoDistribuicao()

API --> WEB : sucesso()
deactivate API

WEB --> Professor : moedasDistribuidas()
deactivate WEB

== 2. Notificação assíncrona ==

NOTIF -> FILA : consumirEvento()

FILA --> NOTIF : eventoDistribuicao

activate NOTIF

NOTIF -> DB : buscarEmailAluno()
activate DB

DB --> NOTIF : emailAluno

deactivate DB

NOTIF -> Aluno : emailRecebimento()

deactivate NOTIF

== 3. Aluno troca moedas ==

Aluno -> WEB : trocarMoedas()
activate WEB

WEB -> API : POST /trocar
activate API

API -> MOEDAS : verificarSaldo()

activate MOEDAS

MOEDAS -> DB : consultarSaldo()
activate DB

DB --> MOEDAS : saldoAtual

MOEDAS -> DB : debitarMoedas()

DB --> MOEDAS : debitoOk

deactivate DB

MOEDAS --> API : saldoAtualizado()
deactivate MOEDAS

API -> CUPOM : gerarCupom()

activate CUPOM

CUPOM -> DB : salvarCupom()
activate DB

DB --> CUPOM : cupomId

deactivate DB

CUPOM --> API : cupomGerado()

deactivate CUPOM

API -> FILA : publicarEventoTroca()

API --> WEB : cupomGerado()
deactivate API

WEB --> Aluno : exibirCupom()
deactivate WEB

== 4. Notificação da troca ==

NOTIF -> FILA : consumirEventoTroca()

FILA --> NOTIF : eventoTroca

activate NOTIF

NOTIF -> DB : buscarEmailAluno()
activate DB

DB --> NOTIF : emailAluno

deactivate DB

NOTIF -> Aluno : emailCupomGerado()

deactivate NOTIF

== 5. Empresa valida cupom ==

Empresa -> WEB : validarQRCode()
activate WEB

WEB -> API : POST /validar-cupom
activate API

API -> CUPOM : validarCupom()

activate CUPOM

CUPOM -> DB : consultarCupom()
activate DB

DB --> CUPOM : cupomValido

CUPOM -> DB : marcarComoUtilizado()

DB --> CUPOM : atualizado

deactivate DB

CUPOM --> API : validacaoSucesso()
deactivate CUPOM

API --> WEB : cupomValidado()
deactivate API

WEB --> Empresa : exibirSucesso()
deactivate WEB

@enduml
