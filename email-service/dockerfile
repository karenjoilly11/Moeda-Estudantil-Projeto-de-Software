# =========================================================
# BUILD STAGE
# =========================================================

FROM eclipse-temurin:21-jdk-alpine AS builder

WORKDIR /app

# Copia arquivos do Maven
COPY pom.xml .
COPY .mvn .mvn
COPY mvnw .

# Dá permissão
RUN chmod +x mvnw

# Baixa dependências primeiro (cache Docker)
RUN ./mvnw dependency:go-offline

# Copia código
COPY src src

# Build
RUN ./mvnw clean package -DskipTests

# =========================================================
# RUNTIME STAGE
# =========================================================

FROM eclipse-temurin:21-jre-alpine

WORKDIR /app

# wget pra healthcheck (a imagem base não traz por default)
RUN apk add --no-cache wget

# Timezone opcional
ENV TZ=America/Sao_Paulo

# Copia JAR gerado
COPY --from=builder /app/target/*.jar app.jar

# Porta do microserviço
EXPOSE 8082

# Healthcheck via /actuator/health. start-period generoso pra startup do Spring.
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=10 \
  CMD wget --quiet --tries=1 --spider http://localhost:8082/actuator/health || exit 1

# Inicialização
ENTRYPOINT ["java", "-jar", "app.jar"]